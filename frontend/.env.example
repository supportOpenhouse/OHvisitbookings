# ─── Database (Neon Postgres, shared CRM DB — this app only touches the `visitbookings` table) ───
DATABASE_URL=postgresql://user:password@host/db?sslmode=require

# ─── Kaleyra SMS OTP (India) ───
KALEYRA_API_KEY=
KALEYRA_ACCOUNT_ID=          # SID, e.g. HXIN...
KALEYRA_OTP_TEMPLATE_ID=     # DLT template id
KALEYRA_SMS_SENDER=          # 6-char DLT sender id
# Must match the DLT-registered SMS template. {otp} is replaced with the 6-digit code.
KALEYRA_OTP_BODY=Your OTP for login is {otp}. Avano Technologies Pvt Ltd.
# Optional: override API base (default https://api.in.kaleyra.io)
# KALEYRA_BASE_URL=https://api.in.kaleyra.io

# ─── App ───
# Random 32+ byte secret used to sign session cookies and hash OTPs. Generate: openssl rand -base64 32
APP_SECRET=
PUBLIC_BASE_URL=https://bookvisit.openhouse.in
BOOKING_AMOUNT_PAISE=99000
# Local development only (ignored in production): log the OTP to the console instead of sending an SMS.
# OTP_DEV_MODE=1

# ─── Razorpay ───
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Dashboard → Settings → Webhooks → https://bookvisit.openhouse.in/api/payments/webhook (event: payment.captured)
RAZORPAY_WEBHOOK_SECRET=

# ─── Interakt (WhatsApp) ───
INTERAKT_API_KEY=            # Dashboard → Developer Settings (already base64; sent as "Authorization: Basic <key>")
INTERAKT_TEMPLATE_NAME=      # approved template name
INTERAKT_TEMPLATE_LANG=en
# Comma-separated booking fields mapped to the template's {{1}},{{2}}... body variables.
# Allowed: name, first_name, phone, email, city, configuration, budget, areas, visit_when, amount, booking_id
INTERAKT_BODY_FIELDS=name
